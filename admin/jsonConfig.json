{
    "i18n": true,
    "type": "panel",
    "items": {
        "headerConnection": {
            "newLine": true,
            "type": "header",
            "text": "connection",
            "size": 2
        },
        "ipaddress": {
            "newLine": true,
            "type": "text",
            "label": "ip",
            "help": "ip_description",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        },
        "port": {
            "type": "number",
            "label": "port",
            "help": "port_description",
            "min": 0,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        },
        "username": {
            "type": "text",
            "label": "username",
            "help": "username_description",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        },
        "password": {
            "type": "password",
            "label": "password",
            "help": "password_description",
            "visible": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        },
        "testConnection": {
            "newLine": true,
            "type": "sendTo",
            "label": "testConnection",
            "command": "testConnection",
            "jsonData": "{\"ipaddress\":\"${data.ipaddress}\",\"port\":${data.port},\"username\":\"${data.username}\",\"password\":\"${data.password}\"}",
            "variant": "outlined",
            "showProcess": true,
            "disabled": "!_alive || !data.ipaddress || !data.port || !data.username || !data.password",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "testConnectionNotAlive": {
            "type": "staticText",
            "text": "testConnectionNotAlive",
            "hidden": "_alive",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 8,
            "xl": 8
        },
        "headerIntervals": {
            "newLine": true,
            "type": "header",
            "text": "intervals",
            "size": 2
        },
        "txtIntervals": {
            "newLine": true,
            "type": "staticText",
            "text": "intervals_details",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        },
        "changeInterval": {
            "type": "number",
            "label": "intervalChange",
            "help": "intervalChange_description",
            "min": 0,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        },
        "roomTemperatureInterval": {
            "type": "number",
            "label": "intervalRoomTemperature",
            "min": 0,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        },
        "weatherInterval": {
            "type": "number",
            "label": "intervalWeather",
            "min": 0,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        },
        "deviceStatusInterval": {
            "type": "number",
            "label": "intervalDeviceStatus",
            "help": "intervalDeviceStatus_description",
            "min": 0,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 6,
            "xl": 6
        }
    }
}
